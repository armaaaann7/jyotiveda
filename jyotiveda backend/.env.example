# Copy to .env — every setting maps to JYOTIVEDA_<NAME> (see src/jyotiveda/config.py)
JYOTIVEDA_ENV=dev
JYOTIVEDA_ROLE=all
JYOTIVEDA_DATABASE_URL=sqlite+aiosqlite:///./jyotiveda.db
JYOTIVEDA_EVENT_BUS=memory
JYOTIVEDA_FORECAST_BACKEND=auto
JYOTIVEDA_ANTHROPIC_API_KEY=
JYOTIVEDA_LLM_MODEL=claude-opus-5-5
JYOTIVEDA_AUTH_MODE=dev
JYOTIVEDA_CONTROL_LOOP_ENABLED=false
JYOTIVEDA_AUTO_APPROVE_MAX_KW=60
