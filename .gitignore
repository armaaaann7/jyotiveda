# ---- Jyotiveda monorepo ------------------------------------------------------------
# Secrets: never commit. Commit only the *.env.example templates.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs and temporary files
*.log
logs/
tmp/
*.tmp

# ---- Backend (Python) ---------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/
# local SQLite databases (runtime state, simulation history, audit rows)
*.db
*.sqlite
*.sqlite3
# fresh per-demo database created by `make demo`
.demo/
# trained model artefacts are not part of the repo (none exist yet)
models/
mlruns/

# ---- Frontend (Node / Vite) ---------------------------------------------------------
node_modules/
dist/
*.tsbuildinfo
# Playwright output / caches and QA screenshots (regenerated by qa.mjs / qa-connected.mjs)
test-results/
playwright-report/
.cache/
